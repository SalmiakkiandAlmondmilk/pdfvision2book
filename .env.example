# 复制本文件为 .env 并填入你的密钥 (也可直接用系统环境变量 DEEPSEEK_API_KEY)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 以下为可选覆盖项, 一般无需修改
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp   # 读图/插图识别(PDF、图片输入)
# DEEPSEEK_TEXT_MODEL=deepseek-v4-flash                # 纯文本翻译(EPUB、TXT 输入)
# DEEPSEEK_TIMEOUT=180
